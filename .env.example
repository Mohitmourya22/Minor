# ---------- REQUIRED ----------
# Clerk (get both from the Clerk dashboard -> API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
# Server-side only. Never expose to the browser, never commit .env.local
CLERK_SECRET_KEY=sk_test_your_key_here

# ---------- OPTIONAL ----------
# Base URL of the REST backend. Defaults to "/api".
# Development example: http://localhost:5000/api
NEXT_PUBLIC_API_BASE_URL=

# Request timeout in milliseconds (default 15000)
NEXT_PUBLIC_API_TIMEOUT_MS=

# Development only: true = use mock services (browser storage). Set to "false" once the backend is live.
NEXT_PUBLIC_USE_MOCKS=true
