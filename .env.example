# =====================================================================
# AayuMarg environment variables.  Copy this file to ".env.local" and fill it in.
# NEVER commit .env.local.  On Vercel add the same names in Project -> Settings -> Environment Variables.
# =====================================================================

# ---------- 1. Clerk (login) ----------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here

# ---------- 2. App mode ----------
# true  = demo mode (browser storage, no backend, no payment)
# false = REAL backend (Supabase + Razorpay + email). Needs everything below.
NEXT_PUBLIC_USE_MOCKS=true
# Optional (defaults are fine): NEXT_PUBLIC_API_BASE_URL=/api   NEXT_PUBLIC_API_TIMEOUT_MS=15000
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_API_TIMEOUT_MS=

# ---------- 3. Supabase (database + file storage) ----------
# Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# the "service_role" key (SECRET - server only, never NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ---------- 4. Payments: Razorpay ----------
# Razorpay Dashboard -> Account & Settings -> API Keys.
# TEST mode keys start with rzp_test_  (use these first, no real money moves)
# LIVE mode keys start with rzp_live_  (real money; switch only after testing)
# KEY_ID is public-safe. KEY_SECRET and WEBHOOK_SECRET are SECRET: server only, never NEXT_PUBLIC_, never in git.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Razorpay Dashboard -> Webhooks -> Add: URL = APP_URL + /api/webhooks/razorpay, event = payment.captured.
# The "secret" you type there must be the same text as this value (any long random string, 30+ characters).
RAZORPAY_WEBHOOK_SECRET=choose_a_long_random_webhook_secret
# Your site address, no trailing slash. Local: http://localhost:3000   Live: https://your-domain.com
APP_URL=http://localhost:3000

# ---------- 5. Email alerts (Gmail) ----------
# Google Account -> Security -> 2-Step Verification ON -> App passwords -> create one (16 letters)
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Who gets the booking / payment emails (leave empty = same as GMAIL_USER)
NOTIFY_EMAIL_TO=

# ---------- 6. Rate limiting (Upstash Redis) ----------
# console.upstash.com -> Create Database (Redis, free plan is enough) -> "REST API" section -> copy both values.
# Secret, server only. If left empty the site still works but rate limiting is OFF.
UPSTASH_REDIS_REST_URL=https://xxxxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token
